# Copia este archivo a .env y completa con las credenciales de tu
# proyecto de Supabase (Project Settings -> API en el dashboard).
#
# VITE_SUPABASE_ANON_KEY es la clave publica ("anon"), segura para
# exponer en el navegador -- la proteccion real de los datos vive en
# las politicas de Row Level Security (ver supabase/migrations).
#
# NUNCA pongas aqui la "service_role key" -- esa clave tiene acceso
# total sin restricciones de RLS y jamas debe llegar al frontend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
